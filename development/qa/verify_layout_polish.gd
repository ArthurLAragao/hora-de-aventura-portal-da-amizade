extends "res://tests/journey_driver.gd"
## Casos isolados: posições e estados preparados NÃO contam como percurso.
func run() -> void:
	root.size=viewport_size
	for slot in [1,2]:
		await fresh("res://level_2.tscn",slot,"cake_player_id")
		var cake=level.cake;var block=level.get_node("PushBlock")
		check("2: contrapeso começa vazio",not level.counterweight.is_active())
		cake.position=Vector2(648,487);level.tunnel_visited=true;await frames(12)
		await tap(cake,"interact")
		check("2: Cake não libera sozinha sem contrapeso",not level.first_unlocked)
		block.position.x=384;await frames(12)
		check("2: bloco real ativa placa",level.counterweight.is_active())
		await tap(cake,"interact")
		check("2: peso mais interação libera mecanismo",level.first_unlocked)
		block.position.x=260;await frames(12);level.recover_pair();await frames(12)
		check("2: queda preserva liberação conquistada e não concede manivela",level.first_unlocked and not level.first_crank.solved and not cake.movement_locked)
		await fresh("res://level_3.tscn",slot,"lead_player_id")
		var layout=level.get_node("RegionalLayout")
		check("3: sequência curta fiel ao SGDD",level.symbol_sequence.size()==3)
		level.marceline.position=Vector2(1712,273.5);await frames(12)
		check("3: uma placa não concede dueto",not layout.confirmation_solved and layout.plates[0].is_active())
		level.bmo.position=Vector2(1808,362);await frames(12)
		check("3: as duas alturas confirmam em conjunto",layout.confirmation_solved and layout.plates[1].is_active())
		level.marceline.position.x=1900;level.bmo.position.x=1940;await frames(12)
		check("3: confirmação permanece, mas não ignora outros puzzles",layout.confirmation_solved and not level.get_node("FriendshipCrystal").monitoring)
		await fresh("res://level_4.tscn",slot,"lead_player_id")
		var c=level.connections
		level.finn.position=Vector2(1432,356);await frames(12)
		for i in 4:await tap(level.finn,"interact")
		check("4: quatro giros retornam à mesma orientação sem resolver",c.turns==[1,3] and not c.solved())
		level.bmo.position=Vector2(1520,288);await frames(12);await tap(level.bmo,"interact")
		check("4: BMO não gira encaixes físicos",c.turns==[1,3])
		level.bmo.position=Vector2(1320,356);await frames(12);await tap(level.bmo,"interact")
		check("4: circuito quebrado recusa energia",not level.energy_terminal.pending and not level.energy_terminal.energized)
		await fresh("res://level_5.tscn",slot,"lead_player_id")
		level.mirrors[4].orientation=0;level.mirrors[5].orientation=1;level.refresh_light()
		check("5: espelho superior sozinho acende só um receptor",level.receivers[3].active and not level.receivers[2].active and not level.solved[2])
		level.mirrors[4].orientation=1;level.mirrors[5].orientation=0;level.refresh_light()
		check("5: espelho inferior sozinho não resolve nenhum feixe final",not level.receivers[2].active and not level.receivers[3].active and not level.solved[2])
		level.mirrors[5].orientation=1;level.refresh_light()
		check("5: dois caminhos reais convergem no espelho superior",level.receivers[2].active and level.receivers[3].active and level.solved[2])
		var before: int=level.beams.size()
		for i in 20:level.refresh_light()
		check("5: atualizações repetidas são determinísticas e limitadas",level.beams.size()==before and before<=level.emitters.size()*level.reflection_limit)
		level.recover_pair();await frames(12)
		check("5: recuperação preserva o final resolvido sem conceder setores anteriores",level.solved==[false,false,true] and not level.checkpoint_active and not level.crystal.is_collected)
	await finish("Layout cooperativo: casos isolados adversariais, não percursos")
