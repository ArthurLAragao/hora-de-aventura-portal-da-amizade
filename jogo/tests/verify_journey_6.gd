extends "res://tests/journey_driver.gd"

func route(slot: int) -> void:
	await fresh("res://level_6.tscn",slot,"primary_player_id")
	var finn: CoopPlayer=level.pair[0]
	var jake: CoopPlayer=level.pair[1]
	check("independent opening, correct duo and no fictitious loaded progress",level.stage==0 and level.checkpoint_stage==0 and level.repaired==[false,false,false] and finn.character_id==&"finn" and jake.character_id==&"jake")
	check("only two active actors, safe separate starts",get_nodes_in_group("players").size()==2 and finn.is_on_floor() and jake.is_on_floor() and finn.player_id==slot and jake.player_id==3-slot)
	await capture("phase6-damaged")
	await walk(jake,444)
	check("Jake requests approach from the bank",level.bridge.can_activate(jake))
	Input.action_press(action(jake,"ability"))
	await until(func():return level.bridge._bridge_active,200)
	await walk(finn,400)
	await jump(finn,488)
	check("A entry lands on Jake support",finn.is_on_floor() and level.bridge.get_dependents().has(finn))
	Input.action_release(action(jake,"ability"))
	await frames(5)
	check("A standing dependency keeps support",level.bridge._bridge_active)
	await tap(finn,"jump")
	await frames(7)
	check("A airborne dependency keeps support",not finn.is_on_floor() and level.bridge._bridge_active)
	await until(func():return finn.is_on_floor())
	Input.action_press(action(jake,"ability"))
	await walk(finn,574)
	await jump(finn,636)
	await walk(finn,648)
	var moved:=await push_until(finn,func():return level.repaired[0],120)
	check("A remote counterweight physically repairs structure",moved and level.permanent.visible and level.stage==0 and not level.repaired[1])
	await capture("phase6-structure")
	Input.action_release(action(jake,"ability"))
	await until(func():return not jake.movement_locked,200)
	await jump(jake,504)
	await jump(jake,636)
	await walk(finn,640)
	await jump(jake,720)
	await jump(jake,784)
	var swapped:=await until(func():return level.stage==1 and not level._transitioning,150)
	check("A finishes only after physical reunion",swapped and level.checkpoint_stage==1 and level.recovery_count==0)
	check("old duo has no controls/collision/group, camera follows new pair",finn.process_mode==Node.PROCESS_MODE_DISABLED and jake.collision_layer==0 and not finn.is_in_group("players") and get_nodes_in_group("players").size()==2 and level.camera.player_a==level.pair[0] and level.camera.player_b==level.pair[1])
	var fionna: CoopPlayer=level.pair[0]
	var cake: CoopPlayer=level.pair[1]
	check("B inherits roles, not temporary actions",fionna.character_id==&"fionna" and cake.character_id==&"cake" and fionna.player_id==slot and cake.player_id==3-slot and not fionna.movement_locked and not cake.get("crawling"))
	await walk(fionna,660)
	await walk(cake,672)
	await jump(cake,720)
	await jump(cake,784)
	await walk(cake,804)
	await tap(cake,"interact")
	check("B context enters geometrically low tunnel",cake.get("crawling"))
	await walk(cake,900)
	check("B real tunnel traversal cannot stand into roof",cake.get("crawling") and not cake.call("can_stand") and level.tunnel_visited)
	await walk(cake,864)
	check("B can retreat in tunnel",cake.get("crawling") and cake.position.x<870)
	await walk(cake,1048)
	await tap(cake,"interact")
	await frames(4)
	check("Cake legitimately frees Fionna's crank",level.mechanism_unlocked and not cake.get("crawling"))
	await jump(fionna,736)
	await walk(fionna,740)
	await jump(fionna,854)
	await walk(fionna,894)
	check("Fionna reuses previous counterweight as step",fionna.is_on_floor() and fionna.position.y<370)
	await tap(fionna,"interact")
	await until(func():return level.lift.get("extended"),300)
	check("crank provides actual return support",level.crank.get("solved") and level.lift.get("extended") and not fionna.movement_locked)
	await walk(fionna,864)
	await capture("phase6-tunnel-crank")
	await jump(cake,1048)
	check("Cake reaches the extended return platform",cake.is_on_floor() and cake.position.y<400)
	await jump(cake,960)
	var second_swap:=await until(func():return level.stage==2 and not level._transitioning,150)
	check("B reciprocal reunion advances C and preserves repairs",second_swap and level.checkpoint_stage==2 and level.repaired==[true,true,false] and level.recovery_count==0)
	var marceline: CoopPlayer=level.pair[0]
	var bmo: CoopPlayer=level.pair[1]
	check("C has correct roles and two active players",marceline.character_id==&"marceline" and bmo.character_id==&"bmo" and marceline.player_id==slot and bmo.player_id==3-slot and get_nodes_in_group("players").size()==2)
	check("C terminal cannot precede legitimate clue",not level.clue_revealed and not level.terminal.monitoring and not level.terminal.call("interact",bmo))
	await jump(marceline,56)
	await jump(marceline,158)
	await walk(marceline,182)
	check("Marceline reaches takeoff using jumps",marceline.is_on_floor() and marceline.position.y<390)
	await jump(marceline,416,true)
	check("limited float reaches musical clue shelf",marceline.is_on_floor() and marceline.position.y<390 and level.recovery_count==0)
	await tap(marceline,"interact")
	await frames(8)
	check("music reveals forms and authorizes terminal",level.clue_revealed and level.clue.visible and level.terminal.monitoring and level.receiver.is_open)
	await walk(bmo,224)
	await jump(bmo,272)
	await walk(bmo,400)
	await jump(bmo,488)
	await walk(bmo,568)
	await tap(bmo,"interact")
	check("terminal opens without accidental confirmation",level.terminal.get("panel_open") and level.terminal.get("entered").is_empty() and bmo.movement_locked and not marceline.movement_locked)
	await walk(marceline,424)
	check("partner still moves during BMO panel",marceline.position.x>420 and level.terminal.get("selection")==0)
	await capture("phase6-terminal-open")
	for key in ["right","right","interact","right","interact","right","interact"]: await tap(bmo,key)
	await frames(10)
	check("BMO enters clue through own controls and restores third seal",level.repaired==[true,true,true] and level.terminal.get("solved") and level.terminal.get("activation_count")==1 and not bmo.movement_locked and not level.terminal.get("panel_open"))
	await capture("phase6-signal")
	await walk(marceline,512)
	await until(func():return marceline.is_on_floor())
	await jump(bmo,636)
	await jump(bmo,720)
	await jump(bmo,784)
	await frames(10)
	check("joint confirmation makes sixth crystal available",level.confirmed and level.crystal.visible and level.crystal_count==0)
	await jump(bmo,720)
	await jump(bmo,640)
	check("crystal collected once; one player cannot end",level.crystal_count==1 and level.completion_count==0)
	await walk(marceline,600)
	await frames(15)
	check("entire three-pair normal route reaches stable ending",level.completion_count==1 and level.exit_area._completed and level.recovery_count==0 and level.checkpoint_stage==2)
	check("six friends celebrate without six controlled bodies",level.has_node("Celebration") and get_nodes_in_group("players").is_empty() and level.crystal_count==1)
	await capture("phase6-celebration")

func run() -> void:
	root.size=viewport_size
	for slot in ([1] if record_dir!="" else [1,2]): await route(slot)
	await finish("New Phase6")
