extends "res://tests/journey_driver.gd"

func route(slot: int) -> void:
	await fresh("res://level_1.tscn",slot,"finn_player_id")
	var finn: CoopPlayer=level.finn
	var jake: CoopPlayer=level.jake
	check("correct duo and unchanged 32x20 grid",finn.player_id==slot and jake.player_id==3-slot and level.get_node("TileMap").tile_set.tile_size==Vector2i(32,20))
	check("safe independent initial floor",finn.is_on_floor() and jake.is_on_floor() and not level.checkpoint.activated and level.fall.recovery_count==0)
	await capture("phase1-start")
	Input.action_press(action(jake,"right"))
	await frames(45)
	Input.action_release(action(jake,"right"))
	check("Jake cannot push or activate tutorial alone",level.tutorial_log.position.x==304 and not level.tutorial_solved)
	await walk(jake,240)
	await walk(finn,260)
	var pushed:=await push_until(finn,func():return level.tutorial_solved)
	check("Finn physically moves tutorial log and opens path",pushed and level.tutorial_gate.is_open and level.tutorial_log.position.x>=400)
	await walk(jake,340)
	await jump(jake,400)
	await jump(jake,476)
	await walk(jake,636)
	check("Jake requests bridge from the safe bank",level.bridge.can_activate(jake) and jake.is_on_floor())
	Input.action_press(action(jake,"ability"))
	await until(func():return level.bridge._bridge_active,200)
	await jump(finn,478)
	await walk(finn,570)
	await jump(finn,686)
	check("Finn entry actually lands on Jake",finn.is_on_floor() and level.bridge.get_dependents().has(finn))
	Input.action_release(action(jake,"ability"))
	await tap(finn,"jump")
	await frames(8)
	check("airborne partner retains the bridge",not finn.is_on_floor() and level.bridge._bridge_active)
	await until(func():return finn.is_on_floor())
	Input.action_press(action(jake,"ability"))
	await walk(finn,760)
	await capture("phase1-bridge")
	await jump(finn,834)
	await walk(finn,866)
	await tap(finn,"interact")
	await frames(8)
	check("Finn lever repairs permanent connection",level.permanent.visible and level.permanent.collision_layer==1)
	Input.action_release(action(jake,"ability"))
	await until(func():return not jake.movement_locked,200)
	await jump(jake,698)
	await jump(jake,834)
	check("Jake follows physically on permanent support",jake.is_on_floor() and jake.position.x>800 and level.fall.recovery_count==0)
	await walk(finn,1048)
	await walk(jake,1090)
	check("checkpoint reached legitimately after shared passage",level.checkpoint.activated and level.fall.recovery_count==0)
	await walk(finn,1315)
	await push_until(finn,func():return level.log.position.x>=1480)
	await walk(jake,1400)
	await jump(jake,1485)
	check("same log becomes Jake's step",jake.is_on_floor() and jake.position.y<310)
	await jump(jake,1570)
	await walk(jake,1856)
	check("upper capability plate opens Finn's route",level.top_plate.is_active() and level.relay_gate.is_open and not level.top_plate._is_accepted(finn))
	await capture("phase1-parallel-routes")
	await walk(jake,1912)
	await frames(8)
	check("leaving the upper plate removes unsolved cooperation",not level.top_plate.is_active() and not level.relay_solved and not level.relay_gate.is_open)
	await walk(jake,1856)
	var combined:=await push_until(finn,func():return level.relay_solved,400)
	check("Finn push plus Jake position solves final combination",combined and level.log.position.x>=1840 and level.final_gate.is_open)
	check("crystal requires the final combination",level.crystal.monitoring and level.crystal_count==0 and not level.exit_area._completed)
	await walk(jake,2004)
	await walk(finn,2150)
	await walk(jake,2280)
	await walk(finn,2230)
	check("crystal collected by real arrival exactly once",level.crystal_count==1)
	check("one character alone cannot finish",not level.exit_area._completed)
	await walk(jake,2336)
	await walk(finn,2300)
	check("complete cooperative route without recovery or reposition",level.completion_count==1 and level.exit_area._completed and level.fall.recovery_count==0)
	await capture("phase1-complete")

func run() -> void:
	root.size=viewport_size
	for slot in ([1] if record_dir!="" else [1,2]): await route(slot)
	await finish("New Phase1")
